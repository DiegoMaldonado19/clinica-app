<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- Dominio puro. Sin base de datos, sin framework. Milisegundos. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Adaptadores contra MariaDB y Redis reales. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Flujos completos por HTTP. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <!--
     | `server` y no `env`: el contenedor inyecta estas mismas variables desde
     | `.env` hacia $_SERVER, que Laravel lee antes que $_ENV. Con <env> ninguna
     | linea de este bloque surtia efecto dentro de Docker y la suite corria
     | como APP_ENV=local contra el Redis y el SMTP de desarrollo.
     -->
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <!-- Unica excepcion: la tuberia corre la suite con CACHE_STORE=null para
             verificar ADR-008, y forzarlo aqui anularia esa verificacion. -->
        <env name="CACHE_STORE" value="array"/>
        <server name="CACHE_PREFIX" value="clinica-test-"/>
        <!-- Base de Redis propia: la suite vacia la cache al arrancar cada
             prueba y no debe poder tocar la de desarrollo. -->
        <server name="REDIS_CACHE_DB" value="15"/>
        <server name="DB_DATABASE" value="clinica_test"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
