APP_NAME="Clinica Psicologia y Bienestar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# UTC en la base de datos; America/Guatemala solo en presentacion (doc 06 §7).
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# doc 05 §3.2
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=clinica
DB_USERNAME=clinica
DB_PASSWORD=clinica

# ADR-008 — si perder Redis pierde algo, no va en Redis.
# Estas tres lineas no se cambian sin cambiar el ADR.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=redis

# 8 h de inactividad en el panel (doc 05 §3.3). El corte de 2 h del portal del
# paciente llega con el portal, en F-08.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false en local porque no hay TLS; true en la nube.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MinIO en local, S3 en la nube. El mismo driver en ambos.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clinica-archivos
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mailpit en local, SES en la nube (ADR-017).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@clinica.local"
MAIL_FROM_NAME="${APP_NAME}"

# Llave de cifrado de las notas SOAP. Parametro DISTINTO de APP_KEY para poder
# rotarlo y auditarlo por separado (doc 05 §2.3).
CLINICAL_ENCRYPTION_KEY=

VITE_APP_NAME="${APP_NAME}"

# Puertos y uid del anfitrion. Solo desarrollo.
HTTP_PORT=80
UID=1000
GID=1000
IMAGE_TAG=local
